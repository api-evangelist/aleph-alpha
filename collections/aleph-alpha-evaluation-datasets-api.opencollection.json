{
  "opencollection": "1.0.0",
  "info": {
    "name": "PhariaStudio Evaluation Datasets API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Evaluation Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Many Datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/datasets",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to retrieve. Starts at 1."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              },
              {
                "name": "benchmarks",
                "value": "",
                "type": "query",
                "description": "If set, sets `associatedBenchmarks` on `Dataset` objects . Otherwise this is null."
              }
            ]
          },
          "docs": "Get Many Datasets"
        },
        {
          "info": {
            "name": "Create Dataset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/datasets",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Create Dataset"
        },
        {
          "info": {
            "name": "Get Dataset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/datasets/:dataset_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "dataset_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "benchmarks",
                "value": "",
                "type": "query",
                "description": "If set, sets `associatedBenchmarks` on `Dataset` objects . Otherwise this is null."
              }
            ]
          },
          "docs": "Get Dataset"
        },
        {
          "info": {
            "name": "Update Dataset",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/datasets/:dataset_id",
            "params": [
              {
                "name": "dataset_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Dataset"
        },
        {
          "info": {
            "name": "Delete Dataset",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/datasets/:dataset_id",
            "params": [
              {
                "name": "dataset_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Dataset"
        },
        {
          "info": {
            "name": "Get Dataset Datapoints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/datasets/:dataset_id/datapoints",
            "params": [
              {
                "name": "dataset_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to retrieve. Starts at 1."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              }
            ]
          },
          "docs": "Get Dataset Datapoints"
        },
        {
          "info": {
            "name": "Create Dataset Download Link",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/datasets/:dataset_id/downloads",
            "params": [
              {
                "name": "dataset_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create Dataset Download Link"
        }
      ]
    }
  ],
  "bundled": true
}