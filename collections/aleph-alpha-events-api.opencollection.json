{
  "opencollection": "1.0.0",
  "info": {
    "name": "PhariaStudio Events API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Many Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/traces/:trace_id/spans/:span_id/events",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "trace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "span_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to retrieve. Starts at 1."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              }
            ]
          },
          "docs": "Get all events of a span."
        },
        {
          "info": {
            "name": "Create Span Event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{host}/v1/studio/projects/:project_id/traces/:trace_id/spans/:span_id/events",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "trace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "span_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new `Event`. You can only add an `Event` to an active `Span`. The client is responsible to create and manage the ID of each event, the server does not accept events with the same ID."
        },
        {
          "info": {
            "name": "Get Event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/traces/:trace_id/spans/:span_id/events/:event_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "trace_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "span_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "event_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a `Event` by its id."
        }
      ]
    }
  ],
  "bundled": true
}