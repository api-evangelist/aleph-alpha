{
  "opencollection": "1.0.0",
  "info": {
    "name": "PhariaStudio Benchmarks API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Benchmarks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Many Benchmarks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/benchmarks",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search term to find results containing this text in any searchable field (case insensitive)."
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query",
                "description": "The column to sort by."
              },
              {
                "name": "sort_direction",
                "value": "",
                "type": "query",
                "description": "The direction to sort by."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to retrieve. Starts at 1."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              }
            ]
          },
          "docs": "Get a list of `Benchmark`s ."
        },
        {
          "info": {
            "name": "Create Benchmark",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/benchmarks",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new `Benchmark`."
        },
        {
          "info": {
            "name": "Get Benchmark",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/benchmarks/:benchmark_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "benchmark_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a `Benchmark` by its ID."
        },
        {
          "info": {
            "name": "Patch Benchmark",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/benchmarks/:benchmark_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "benchmark_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific`Benchmark`."
        },
        {
          "info": {
            "name": "Delete Benchmark",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{host}/v1/studio/projects/:project_id/evaluation/benchmarks/:benchmark_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "benchmark_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a specific`Benchmark`."
        }
      ]
    }
  ],
  "bundled": true
}