{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aleph Alpha Document Index Service API",
    "version": "0.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Service",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ping the Document Index.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/search/",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Ping the Document Index."
        },
        {
          "info": {
            "name": "Liveness state of the Document Index.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/search/health/liveness",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Liveness state of the Document Index."
        },
        {
          "info": {
            "name": "Readiness state of the Document Index.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/search/health/readiness",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Readiness state of the Document Index."
        }
      ]
    }
  ],
  "bundled": true
}