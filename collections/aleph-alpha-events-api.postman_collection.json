    {
      "id": "da797ea9-e8c9-474a-9d64-bedf00f9670c",
      "name": "Events",
      "description": {
        "content": "Endpoints for handling Events. Events capture detailed information about specific occurrences within a Span. This includes logs, exceptions, and other relevant data points that provide a granular view of the operations within a Span. Events are crucial for diagnosing issues and understanding the execution context.",
        "type": "text/plain"
      },
