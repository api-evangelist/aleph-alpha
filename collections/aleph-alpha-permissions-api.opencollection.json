{
  "opencollection": "1.0.0",
  "info": {
    "name": "Aleph Alpha Permissions API",
    "version": "4.7.0"
  },
  "items": [
    {
      "info": {
        "name": "permissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check user privileges",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{host}/v1/check_privileges",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Post an array of permissions as an authenticated users.\nWe return the subset of the posted permissions that have been granted to the user.\n"
        }
      ]
    }
  ],
  "bundled": true
}