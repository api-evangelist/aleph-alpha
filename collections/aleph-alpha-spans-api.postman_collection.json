    {
      "id": "2398e8ea-05e9-4e72-81dc-ed3f0760ed34",
      "name": "Spans",
      "description": {
        "content": "Endpoints for managing Spans. A Span is a single unit of work within a Trace and represents an individual operation in the execution sequence. Spans help in breaking down the Trace into more manageable parts, providing detailed insights into each operation's performance and behavior.",
        "type": "text/plain"
      },
