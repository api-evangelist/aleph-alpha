{
  "opencollection": "1.0.0",
  "info": {
    "name": "PhariaStudio Traces API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Traces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Many Traces",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/traces",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to retrieve. Starts at 1."
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The number of items per page."
              },
              {
                "name": "only_root",
                "value": "",
                "type": "query",
                "description": "Return only the root span instead of all spans"
              }
            ]
          },
          "docs": "List paginated `Traces`."
        },
        {
          "info": {
            "name": "Create Trace",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{host}/v1/studio/projects/:project_id/traces",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new `Trace`. All submitted spans must have the same trace id."
        },
        {
          "info": {
            "name": "Get Trace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{host}/v1/studio/projects/:project_id/traces/:trace_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "trace_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a `Trace` by its id."
        }
      ]
    }
  ],
  "bundled": true
}