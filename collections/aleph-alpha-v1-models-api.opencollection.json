{
  "opencollection": "1.0.0",
  "info": {
    "name": "PhariaOS Manager V1/models API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "v1/models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all foundation models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pharia.example.com/v1/os/v1/foundation-models",
            "params": [
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort models ascending (asc) or descending (desc). Ascending is the default."
              }
            ]
          },
          "docs": "List all available foundation models"
        },
        {
          "info": {
            "name": "List all inference runtimes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pharia.example.com/v1/os/v1/inference-runtimes",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter is a struct that contains the filter fields for the Inference Runtimes.\nexample: {\"supportedModel\":\"Llama-3.1-8B-Instruct\"}"
              }
            ]
          },
          "docs": "List all available inference runtimes supported to deploy models. Currently the supported inference runtimes are Aleph Alpha authorial Luminous and vLLM"
        },
        {
          "info": {
            "name": "List all models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pharia.example.com/v1/os/v1/models",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "ModelFilter is a struct that contains the filter fields for the model.\nexample: {\"name\":\"model-name\", \"type\":\"base-model\", \"inferenceRuntime\":\"vllm\"}"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all models"
        },
        {
          "info": {
            "name": "Create a new model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pharia.example.com/v1/os/v1/models",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new model"
        },
        {
          "info": {
            "name": "Get model by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pharia.example.com/v1/os/v1/models/:modelID",
            "params": [
              {
                "name": "modelID",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ]
          },
          "docs": "Retrieve a model by its ID"
        },
        {
          "info": {
            "name": "Update a model",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.pharia.example.com/v1/os/v1/models/:modelID",
            "params": [
              {
                "name": "modelID",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a model"
        },
        {
          "info": {
            "name": "Delete a model",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pharia.example.com/v1/os/v1/models/:modelID",
            "params": [
              {
                "name": "modelID",
                "value": "",
                "type": "path",
                "description": "Model ID"
              }
            ]
          },
          "docs": "Delete a model"
        }
      ]
    }
  ],
  "bundled": true
}